# Copia este archivo como .env.docker (no se sube a git) y cambia los valores marcados.
# Sirve para probar el despliegue en tu equipo con docker compose; en producción revisa
# también la lista de docs/pendientes-manuales.md (HTTPS, dominio, SMTP real).

# Puerto de tu equipo donde queda la aplicación.
INFOTRIP_PUERTO=8080

# ─── Django (configuración infotrip.settings.prod) ───
# CAMBIAR: 50+ caracteres aleatorios. Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-al-menos-cincuenta-caracteres
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8080
# nginx delante: Django confía en una sola cabecera X-Forwarded-For.
NUM_PROXIES=1
# Para probar sin HTTPS en tu equipo. En producción con HTTPS: True, y HSTS a 3600 al principio.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
LOG_LEVEL=INFO
# Opcional: errores del servidor a Sentry o GlitchTip (docs/operacion.md).
SENTRY_DSN=

# ─── Base de datos (la usan el contenedor db y Django) ───
POSTGRES_DB=infotrip
POSTGRES_USER=infotrip
# CAMBIAR
POSTGRES_PASSWORD=cambia-esta-contrasena
DB_NAME=infotrip
DB_USER=infotrip
# CAMBIAR: la misma que POSTGRES_PASSWORD
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

# ─── Correo ───
# En consola para probar: los correos aparecen en `docker compose logs web avisos`.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=InfoTrip <no-reply@localhost>

# Opcional: clave del DENUE del INEGI para `importar_denue`.
DENUE_TOKEN=

# ─── Datos siempre al día (opcional, docs/actualizacion-datos.md) ───
# Tareas del servicio `tareas`: denue (mensual), osm y fuentes_oficiales (semanales). Sin la línea, corren las tres;
# vacía (TAREAS_PROGRAMADAS=), ninguna.
# TAREAS_PROGRAMADAS=denue,osm,fuentes_oficiales
# Clave de la API de Claude para leer precios y horarios de sitios oficiales. Vacía: esa tarea se salta.
# Solo se usa cuando una página cambió; nada se publica sin aprobación en /admin/moderacion/.
ANTHROPIC_API_KEY=
# Modelo para extraer los datos. Vacío: claude-haiku-5-5 (pequeño y barato).
IA_MODELO=

# Opcional: sube cada respaldo diario a S3 (docs/operacion.md). Vacío: solo la copia local.
RESPALDO_S3_BUCKET=
RESPALDO_S3_REGION=
