# Plantilla para el servidor de AWS. En el servidor: cp .env.docker.aws.example .env.docker
# y cambia todo lo marcado con CAMBIAR. Este archivo no lleva secretos; .env.docker sí y no se sube a git.
# Guía completa: docs/despliegue-aws.md

# ─── Dominio y HTTPS (Caddy) ───
# CAMBIAR: tu dominio, sin https:// ni www (por ejemplo infotrip.online). www.<dominio> redirige a él.
DOMINIO=infotrip.ejemplo.com
# CAMBIAR: Let's Encrypt avisa aquí si un certificado está por vencer.
CORREO_CERTIFICADO=correo-del-proyecto@gmail.com

# ─── Django (infotrip.settings.prod) ───
# CAMBIAR: genera una nueva, distinta a la de tu equipo:
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esto
# CAMBIAR: el mismo dominio de arriba, también con www.
ALLOWED_HOSTS=infotrip.ejemplo.com,www.infotrip.ejemplo.com
# CAMBIAR: https:// y el mismo dominio.
PUBLIC_BASE_URL=https://infotrip.ejemplo.com
# Caddy → nginx → Django: Django confía en una sola IP, la que fijó Caddy.
NUM_PROXIES=1
DETRAS_DE_PROXY_HTTPS=True
SECURE_SSL_REDIRECT=True
# Empieza con 1 hora; súbelo a 31536000 cuando todo funcione bien por HTTPS.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=INFO
SENTRY_DSN=
# CAMBIAR: correo de contacto del aviso de privacidad.
CONTACTO_PRIVACIDAD=correo-del-proyecto@gmail.com

# ─── Base de datos ───
POSTGRES_DB=infotrip
POSTGRES_USER=infotrip
# CAMBIAR: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=cambia-esto
DB_NAME=infotrip
DB_USER=infotrip
# CAMBIAR: la misma que POSTGRES_PASSWORD
DB_PASSWORD=cambia-esto
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

# ─── Correo (Gmail del proyecto con contraseña de aplicación) ───
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# CAMBIAR
EMAIL_HOST_USER=correo-del-proyecto@gmail.com
# CAMBIAR: la contraseña de aplicación de 16 letras, sin espacios.
EMAIL_HOST_PASSWORD=
# CAMBIAR
DEFAULT_FROM_EMAIL=InfoTrip <correo-del-proyecto@gmail.com>

# Opcional: clave del DENUE del INEGI para `importar_denue`.
DENUE_TOKEN=
