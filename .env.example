# Copia los valores a .env y reemplaza los ejemplos. Esta cuenta NO ha sido creada.
SECRET_KEY=reemplaza-por-una-clave-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=infotrip
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Prueba local: imprime el mensaje en la terminal, no entrega correo.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para envío real: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=infotrip.pruebas@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=InfoTrip <infotrip.pruebas@gmail.com>

# Origen de los enlaces de recuperación; usar HTTPS y tu dominio al publicar.
PUBLIC_BASE_URL=http://127.0.0.1:8000
