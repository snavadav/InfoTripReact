# Copia los valores a .env y reemplaza los ejemplos. Esta cuenta NO ha sido creada.

# ─── Entorno ──────────────────────────────────────────────────
# manage.py usa infotrip.settings.dev si no se indica otro; wsgi/asgi usan infotrip.settings.prod.
# Opciones: infotrip.settings.dev | .local (SQLite) | .test | .prod
# DJANGO_SETTINGS_MODULE=infotrip.settings.dev

# En producción es obligatoria (50+ caracteres aleatorios). Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=reemplaza-por-una-clave-aleatoria
# Solo lo leen dev/local; en producción DEBUG siempre es False.
DEBUG=True
# En producción es obligatorio: dominios públicos separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=infotrip
DB_USER=infotrip_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Prueba local: imprime el mensaje en la terminal, no entrega correo.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para envío real: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=infotrip.pruebas@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=InfoTrip <infotrip.pruebas@gmail.com>

# Origen de los enlaces de recuperación; usar HTTPS y tu dominio al publicar.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Proxies inversos de confianza (0 = sin proxy; 1 detrás de nginx o balanceador).
NUM_PROXIES=0

# ─── Solo producción (infotrip.settings.prod) ─────────────────
# True si nginx/balanceador termina HTTPS y envía X-Forwarded-Proto.
# DETRAS_DE_PROXY_HTTPS=False
# SECURE_SSL_REDIRECT=True
# Empieza con 3600 al publicar por primera vez; sube a 31536000 cuando todo vaya por HTTPS.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Caché compartida para los límites de intentos. Vacía = caché local (solo desarrollo).
# Obligatoria en producción. Ejemplo: redis://localhost:6379/0
REDIS_URL=
