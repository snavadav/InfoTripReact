# HTTPS para el servidor de AWS: Caddy obtiene y renueva solo el certificado de Let's Encrypt para
# $DOMINIO y reenvía todo a nginx. Lo usa docker-compose.aws.yml; en tu equipo no hace falta.
{
	email {$CORREO_CERTIFICADO}
}

{$DOMINIO} {
	encode zstd gzip
	# Caddy reemplaza X-Forwarded-For con la IP real del visitante (no confía en la que mande él)
	# y añade X-Forwarded-Proto: https. nginx los pasa tal cual a Django.
	# Las cabeceras de Django (incluido "Cache-Control: no-cache" de /sw.js) pasan sin cambios.
	reverse_proxy nginx:80
}

# www.$DOMINIO lleva al dominio principal, con su propio certificado. Necesita un registro A `www` hacia la misma IP;
# sin él, Caddy solo deja avisos en su registro y el dominio principal sigue funcionando.
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}
